; Engine configuration file.
; WingIt mobile prototype — Godot 4.2+

config_version=5

[application]

config/name="WingIt"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[autoload]

GameProgress="*res://scripts/progress_store.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=432
window/size/window_height_override=768
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.12, 1)
